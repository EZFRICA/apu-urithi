# Copy this file to .env and fill in what you need. .env is gitignored; this template is not,
# so never put a real key here.
#
# Every setting this project reads is prefixed APPRENTICE_, except the providers' own names,
# so nothing exported for another project on this machine can move this one.

# ── Required: the models that watch, ask and judge ───────────────────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Speech: the apprentice's voice and its ears ──────────────────────────────
# Without it everything still works in print and in braille. https://elevenlabs.io/
ELEVENLABS_API_KEY=
# A voice from your own account: library voices need a paid plan.
# ELEVENLABS_VOICE_ID=
# URITHI_TTS_PROVIDER=elevenlabs
# URITHI_TTS_MODEL=eleven_v4_turbo
# URITHI_STT_PROVIDER=elevenlabs
# URITHI_STT_MODEL=scribe_v2
# If either provider is set to gemini instead:
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# GEMINI_TTS_VOICE=Kore
# GEMINI_TRANSCRIBE_MODEL=gemini-3.8-flash

# ── Provenance: each rule checked against public sources ─────────────────────
# Bright Data first: a SERP zone searches as a person in the expert's country would, and a
# Web Unlocker zone reads the page behind each result. https://brightdata.com/
BRIGHTDATA_API_TOKEN=
# BRIGHTDATA_SERP_ZONE=serp_api
# BRIGHTDATA_UNLOCKER_ZONE=web_unlocker
# Tavily otherwise. https://tavily.com/
# TAVILY_API_KEY=

# ── Knowledge [B]: the library, in Neo4j ─────────────────────────────────────
# Without NEO4J_URI the library runs in memory and lasts as long as the server.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
# NEO4J_DATABASE=
# The local embedding model (multilingual, 384 dimensions), never downloaded at runtime.
# URITHI_EMBEDDING_CACHE_DIR=./models

# ── Signed packages ──────────────────────────────────────────────────────────
# The library signs every knowledge package (Ed25519), so a package handed on as a file is
# checked offline. Without this, a key is made once under the data directory. A server whose
# disk does not last (Cloud Run) needs it, as a PEM, or its packages fail after a restart.
# LEARNER_SIGNING_KEY=

# ── Models, one per role, all with working defaults ──────────────────────────
# URITHI_PROVIDER=gemini
# URITHI_MODEL=gemini-3.8-flash
# URITHI_EXTRACTION_PROVIDER=gemini
# URITHI_EXTRACTION_MODEL=gemini-3.5-flash-lite
# URITHI_VISION_MODEL=gemini-3.8-flash
# URITHI_CLASS_VISION_MODEL=gemini-3.5-flash-lite
# URITHI_QUESTION_MODEL=        (the main model when unset; a faster one of the same provider)
# URITHI_ANSWER_MODEL=          (the main model when unset; a learner waits on it)

# ── Metering: quotas, ceilings and prices (apu/meter.py) ──────────────────────
# The policy (quotas per role and period, cost ceilings) is data in registries/policy.json.
# URITHI_POLICY_PATH=./registries/policy.json
# No provider returns a price: the price of each model role, in USD per million tokens
# "input,output", taken from the provider's pricing page for the model set for that role.
# Without one, that role's calls are costed at zero and the log says so once. The values below
# are the paid standard tier for the defaults above, read 2026-10-10 (main and vision rise on
# 2027-01-01). Picture output is priced at the image-output rate. The question, answer and class
# vision models have no price of their own: they are costed at the main and vision prices.
# URITHI_PRICE_MAIN=0.75,3.75
# URITHI_PRICE_EXTRACTION=0.30,2.50
# URITHI_PRICE_VISION=0.75,3.75
# URITHI_PRICE_PICTURE=0.50,60.00
# URITHI_PRICE_TRANSCRIBE=2.00,12.00
# A cheaper model for the main role, used only near a ceiling, once measured for the role.
# URITHI_MODEL_CHEAPER=
# Records written before organisations existed belong to this one.
# URITHI_LEGACY_ORGANISATION=urithi

# ── The server ───────────────────────────────────────────────────────────────
# URITHI_PORT=8790
# Loopback by default. 0.0.0.0 only for a demo on a network you trust: nothing here
# authenticates who reads what an expert said about their work.
# URITHI_HOST=127.0.0.1

# ── Storage ──────────────────────────────────────────────────────────────────
# Each package keeps its own data; the two sides never write to each other's.
# GUARDIAN_DATA_DIR=./guardian/data      work maps and working memories
# LEARNER_DATA_DIR=./learner/data        progress, renderings, the packages' signing key
# EXCHANGE_DATA_DIR=./exchange/data      the question box
# URITHI_LOG_DIR=./logs
# Where a deposited document goes once a validated part cites it (Cloud Storage, under
# organisation/guardian/<guardian>/<map>/). Empty: cited documents stay on local disk.
# GUARDIAN_SOURCES_BUCKET=
# GCS_BUCKET_NAME=

# ── Speech limits, all with working defaults ─────────────────────────────────
# The recording accepted, the text read out, and the check that catches audio the model
# stopped reading early (measured at roughly 15 characters per second).
# URITHI_VOICE_MAX_RECORDING_BYTES=8388608
# URITHI_VOICE_MAX_SPOKEN_CHARS=4000
# URITHI_VOICE_CHARS_PER_SECOND=15
# URITHI_VOICE_MIN_AUDIO_RATIO=0.6

# ── Braille ──────────────────────────────────────────────────────────────────
# Needs the liblouis C library (brew install liblouis / apt install liblouis-dev).
# Only set this if the library is somewhere non-standard.
# LIBLOUIS_PATH=

# ── Traces of the model calls (Arize), off unless both are set ───────────────
# Which model, how long, how many tokens, what failed: never a prompt or an answer
# (apu/observability.py). Both are on the Space Settings page of Arize.
# ARIZE_API_KEY=
# ARIZE_SPACE_ID=
# URITHI_TRACING_PROJECT=urithi
# URITHI_TRACING_REGION=eu      (the space's region: us, the default, or eu; a wrong one says "invalid Space ID")
# URITHI_TRACING=0              (turns tracing off without removing the key)
# URITHI_TRACING_TEXTS=1        (the owner's choice: prompts and answers, distress included, stored at Arize)
